{
  "name": "kunalkabra-personal-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner && node scripts/prepare-pages.mjs",
    "build:pages": "npm run build && node scripts/export-pages.mjs",
    "preview": "vite preview --configLoader runner",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:pages": "npm run build:pages && node --test tests/*.test.mjs && node scripts/verify-pages-export.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  }
}
